# Copy to .env (same directory, gitignored) and fill in your key.
# The server itself never calls an LLM; these settings are for clients,
# test scripts, and harnesses that drive the MCP tools with a model.

# Required: any OpenAI-compatible chat-completions API key.
LLM_API_KEY=sk-put-your-key-here

# Optional overrides (defaults shown). The default base URL is the ASU endpoint.
# LLM_BASE_URL=https://openai.rc.asu.edu/v1
# LLM_MODEL=llama3-groq-70b-tool-use
